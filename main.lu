//! check: run(exit=0)
//! phase: 4

// spell — dictionary spell checker with trie suggestions
//
// File layout (README §5):
//   main.lu      — CLI entry, argument dispatch, main loop
//   lev.lu       — Levenshtein distance (capped and uncapped)
//   trie.lu      — trie construction and search
//   tokens.lu    — word tokenization (apostrophe rules, case folding)
//   dict.lu      — dictionary loading, case variants, ignore list
//   suggest.lu   — brute-force suggestions
//   *_test.lu    — tests for each module
//
// CLI (README §4):
//   spell [--dict FILE] [--ignore FILE] [--radius N] [--max N] [FILE|-]...
//   spell suggest [--radius N] [--max N] WORD...
//   spell check-index [--dict FILE] [--seed N]
//   spell bench [--dict FILE]
//   spell --help
//
// Exit codes: --help → 0, unknown subcommand/usage error → 2

use std.env
use std.fs
use std.str
use std.rand
use std.time

fn main() -> !int {
    let args = env.args()
    if args.len == 0 {
        print("Usage: spell [--dict FILE] [--ignore FILE] [--radius N] [--max N] [FILE|-]...")
        print("       spell suggest [--radius N] [--max N] WORD...")
        print("       spell check-index [--dict FILE] [--seed N]")
        print("       spell bench [--dict FILE]")
        return 2
    }

    // --help anywhere → print help and exit 0
    for a in args {
        if a == "--help" {
            print(
                "Usage: spell [--dict FILE] [--ignore FILE] [--radius N] [--max N] [--damerau] [FILE|-]...",
            )
            print("       spell suggest [--radius N] [--max N] [--damerau] WORD...")
            print("       spell check-index [--dict FILE] [--seed N]")
            print("       spell bench [--dict FILE] [--damerau]")
            print("       spell --help")
            print("")
            print("  spell suggest: known words print 'WORD: known'.")
            print("  Capitalization hints are marked with ~ (e.g. 'paris' → '~ Paris').")
            print("  All-caps words are known if any dictionary word matches case-insensitively.")
            print("  Unknown all-caps words get the suggestions their lower-case form gets.")
            print("  Multi-file mode prefixes output with FILE: (e.g. 'file.txt:1:3: word').")
            print(
                "  --damerau: use restricted Damerau-Levenshtein distance (optimal string alignment; transpositions count as 1 edit).",
            )
            return 0
        }
    }

    // Subcommand dispatch
    let first = args[0]
    if first == "suggest" {
        return cmd_suggest(args)
    }
    if first == "check-index" {
        return cmd_check_index(args)
    }
    if first == "bench" {
        return cmd_bench(args)
    }

    // Not a subcommand — process all args as flags and file names
    var dict_path = "/usr/share/dict/words"
    var ignore_path: str = ""
    var radius = 2
    var max_suggest = 8
    var damerau = false
    var files = List[str]()

    var i = 0
    while i < args.len {
        let arg = args[i]
        if arg == "--dict" {
            if i + 1 >= args.len {
                print("spell: --dict requires a file argument")
                return 2
            }
            i = i + 1
            dict_path = args[i]
        } else if arg == "--ignore" {
            if i + 1 >= args.len {
                print("spell: --ignore requires a file argument")
                return 2
            }
            i = i + 1
            ignore_path = args[i]
        } else if arg == "--radius" {
            if i + 1 >= args.len {
                print("spell: --radius requires a value")
                return 2
            }
            i = i + 1
            radius = args[i].to_int() else |e| {
                print("spell: invalid radius: {e}")
                return 2
            }
        } else if arg == "--max" {
            if i + 1 >= args.len {
                print("spell: --max requires a value")
                return 2
            }
            i = i + 1
            max_suggest = args[i].to_int() else |e| {
                print("spell: invalid max: {e}")
                return 2
            }
        } else if arg == "--damerau" {
            damerau = true
        } else if arg[0..1] == "-" && arg != "-" {
            print("spell: unknown option: {arg}")
            return 2
        } else {
            (mut files).push(arg)
        }
        i = i + 1
    }

    // Load dictionary
    let dict = load_dict(dict_path) else |e| {
        print("spell: cannot load dictionary: {e}")
        return 2
    }

    // Load ignore list if specified
    var ignore = List[str]()
    if ignore_path.len > 0 {
        ignore = load_ignore(ignore_path) else |e| {
            print("spell: cannot load ignore file: {e}")
            return 2
        }
    }

    // Build the trie for suggestions
    let trie = build_trie(dict.words)

    // Process files
    var found_unknown = false
    let multi = files.len > 1

    if files.len == 0 {
        // Read from stdin
        let lines = read_stdin()
        var line_num = 1
        for line in lines {
            let unknowns = find_unknowns(line, dict, ignore)
            for (col, word) in unknowns {
                let suggestions = if damerau {
                    suggest_brute(word, dict.words, radius, true)
                } else {
                    suggest_with_trie(trie, dict.words, word, radius)
                }
                let formatted = format_suggestions(suggestions, word, max_suggest)
                print("{line_num}:{col}: {word}  → {formatted}")
                found_unknown = true
            }
            line_num = line_num + 1
        }
    } else {
        for file in files {
            if file == "-" {
                let lines = read_stdin()
                var line_num = 1
                for line in lines {
                    let unknowns = find_unknowns(line, dict, ignore)
                    for (col, word) in unknowns {
                        let suggestions = if damerau {
                            suggest_brute(word, dict.words, radius, true)
                        } else {
                            suggest_with_trie(trie, dict.words, word, radius)
                        }
                        let formatted = format_suggestions(suggestions, word, max_suggest)
                        if multi {
                            print("{file}:{line_num}:{col}: {word}  → {formatted}")
                        } else {
                            print("{line_num}:{col}: {word}  → {formatted}")
                        }
                        found_unknown = true
                    }
                    line_num = line_num + 1
                }
            } else {
                // Read entire file at once to avoid splitting words at chunk boundaries
                let content = fs.read_text(file) else |e| {
                    match copy e {
                        utf8 => {
                            print("spell: {file}:1: not UTF-8")
                            return 2
                        },
                        io => {
                            print("spell: cannot read {file}: {e}")
                            return 2
                        },
                        _ => {
                            print("spell: cannot read {file}: {e}")
                            return 2
                        },
                    }
                }
                var line_num = 1
                let lines = str.lines(content)
                for l in lines {
                    let unknowns = find_unknowns(l, dict, ignore)
                    for (col, word) in unknowns {
                        let suggestions = if damerau {
                            suggest_brute(word, dict.words, radius, true)
                        } else {
                            suggest_with_trie(trie, dict.words, word, radius)
                        }
                        let formatted = format_suggestions(suggestions, word, max_suggest)
                        if multi {
                            print("{file}:{line_num}:{col}: {word}  → {formatted}")
                        } else {
                            print("{line_num}:{col}: {word}  → {formatted}")
                        }
                        found_unknown = true
                    }
                    line_num = line_num + 1
                }
            }
        }
    }

    if found_unknown {
        return 1
    }
    return 0
}

/// The `suggest` subcommand: spell suggest [--radius N] [--max N] [--damerau] WORD...
fn cmd_suggest(args: List[str]) -> !int {
    var radius = 2
    var max_suggest = 8
    var damerau = false
    var words = List[str]()

    var i = 1
    while i < args.len {
        let arg = args[i]
        if arg == "--radius" {
            if i + 1 >= args.len {
                print("spell: --radius requires a value")
                return 2
            }
            i = i + 1
            radius = args[i].to_int() else |e| {
                print("spell: invalid radius: {e}")
                return 2
            }
        } else if arg == "--max" {
            if i + 1 >= args.len {
                print("spell: --max requires a value")
                return 2
            }
            i = i + 1
            max_suggest = args[i].to_int() else |e| {
                print("spell: invalid max: {e}")
                return 2
            }
        } else if arg == "--damerau" {
            damerau = true
        } else if arg[0..1] == "-" {
            print("spell: unknown option: {arg}")
            return 2
        } else {
            (mut words).push(arg)
        }
        i = i + 1
    }

    if words.len == 0 {
        print("spell: no words to suggest")
        return 2
    }

    let dict = load_dict("/usr/share/dict/words") else |e| {
        print("spell: cannot load dictionary: {e}")
        return 2
    }

    // Build the trie for suggestions
    let trie = build_trie(dict.words)

    var found_unknown = false

    for word in words {
        // If the word is known, say so
        if is_known(word, dict) {
            print("{word}: known")
            continue
        }
        // Check all-caps form
        if is_known_uppercase(word, dict) {
            print("{word}: known")
            continue
        }
        found_unknown = true
        // For all-caps tokens, use the lower-case form for suggestions
        let query = if is_all_upper(word) {
            str.lower(word)
        } else {
            word
        }
        let suggestions = if damerau {
            suggest_brute(query, dict.words, radius, true)
        } else {
            suggest_with_trie(trie, dict.words, query, radius)
        }
        let formatted = format_suggestions(suggestions, query, max_suggest)
        print("{word}  → {formatted}")
    }

    if found_unknown {
        return 1
    }
    return 0
}

/// The `check-index` subcommand: compare trie vs brute-force on 500 edited words.
fn cmd_check_index(args: List[str]) -> !int {
    var dict_path = "/usr/share/dict/words"
    var seed = 0

    var i = 1
    while i < args.len {
        let arg = args[i]
        if arg == "--dict" {
            if i + 1 >= args.len {
                print("spell: --dict requires a file argument")
                return 2
            }
            i = i + 1
            dict_path = args[i]
        } else if arg == "--seed" {
            if i + 1 >= args.len {
                print("spell: --seed requires a value")
                return 2
            }
            i = i + 1
            seed = args[i].to_int() else |e| {
                print("spell: invalid seed: {e}")
                return 2
            }
        }
        i = i + 1
    }

    let dict = load_dict(dict_path) else |e| {
        print("spell: cannot load dictionary: {e}")
        return 2
    }

    // Build the trie
    let trie = build_trie(dict.words)

    // Build a random number generator
    var r = rand.new(seed)

    var agreed = 0
    var total = 500

    for _ in 0..total {
        // Pick a random word from the dictionary
        let idx = rand.below(mut r, dict.words.len)
        let word = dict.words[idx]

        // Apply a random edit
        let misspelled = apply_random_edit(word, mut r)

        // Compare trie vs brute-force
        let bf_results = suggest_brute(misspelled, dict.words, 2, false)
        let bf_words = extract_words(bf_results)

        let (trie_results, _) = search(trie, misspelled, 2)
        var trie_results_list = List[(int, str)]()
        for (d, idx) in trie_results {
            (mut trie_results_list).push((d, dict.words[idx]))
        }
        let trie_words = extract_words(trie_results_list)

        let bf_words_sorted = copy bf_words
        sort_strs_list(mut bf_words_sorted)
        let trie_words_sorted = copy trie_words
        sort_strs_list(mut trie_words_sorted)

        if lists_equal(trie_words_sorted, bf_words_sorted) {
            agreed = agreed + 1
        } else {
            print("DISAGREE {misspelled}:")
            print("  trie: {trie_words.len} words")
            print("  bf:   {bf_words.len} words")
        }
    }

    print("agree {agreed}/{total}")

    if agreed == total {
        return 0
    }
    return 1
}

/// The `bench` subcommand: build time, query stats, brute-force comparison.
fn cmd_bench(args: List[str]) -> !int {
    var dict_path = "/usr/share/dict/words"
    var damerau = false

    var i = 1
    while i < args.len {
        let arg = args[i]
        if arg == "--dict" {
            if i + 1 >= args.len {
                print("spell: --dict requires a file argument")
                return 2
            }
            i = i + 1
            dict_path = args[i]
        } else if arg == "--damerau" {
            damerau = true
        }
        i = i + 1
    }

    let dict = load_dict(dict_path) else |e| {
        print("spell: cannot load dictionary: {e}")
        return 2
    }

    // Measure build time
    let build_start = time.now()
    let trie = build_trie(dict.words)
    let build_dur = time.elapsed(build_start)
    let build_ms = time.as_millis(build_dur)

    let n_nodes = node_count(trie)
    print("build: {build_ms} ms, {n_nodes} nodes")

    // Generate random queries
    var r = rand.new(123)
    var total_visited = 0
    var query_times = List[int]()
    var visited_counts = List[int]()
    let num_queries = 200

    for _ in 0..num_queries {
        let idx = rand.below(mut r, dict.words.len)
        let word = dict.words[idx]
        let misspelled = apply_random_edit(word, mut r)

        let q_start = time.now()
        let (results, visited) = search(trie, misspelled, 2)
        let q_dur = time.elapsed(q_start)
        let q_ms = time.as_millis(q_dur)

        total_visited = total_visited + visited
        (mut query_times).push(q_ms)
        (mut visited_counts).push(visited)
    }

    let mean_visited = total_visited / num_queries
    let pct_visited = mean_visited * 100 / n_nodes

    // Compute median and p99 for query times
    sort_ints(mut query_times)
    let median_ms = query_times[num_queries / 2]
    let p99_idx = num_queries * 99 / 100
    let p99_ms = query_times[p99_idx]

    // Compute median and max for visited counts
    sort_ints(mut visited_counts)
    let median_visited = visited_counts[num_queries / 2]
    let max_visited = visited_counts[num_queries - 1]
    let pct_median = median_visited * 100 / n_nodes
    let pct_max = max_visited * 100 / n_nodes

    print(
        "queries: {num_queries}, visited mean: {mean_visited} ({pct_visited}%), median: {median_visited} ({pct_median}%), max: {max_visited} ({pct_max}%)",
    )
    print("query time: median {median_ms} ms, p99 {p99_ms} ms")

    // Brute-force time for one query
    let idx = rand.below(mut r, dict.words.len)
    let word = dict.words[idx]
    let misspelled = apply_random_edit(word, mut r)

    let bf_start = time.now()
    let bf_results = suggest_brute(misspelled, dict.words, 2, damerau)
    let bf_dur = time.elapsed(bf_start)
    let bf_ms = time.as_millis(bf_dur)

    print("brute-force: {bf_ms} ms for one query ({bf_results.len} results)")

    // Speedup
    if median_ms > 0 {
        let speedup = bf_ms / median_ms
        print("speedup: {speedup}x (trie vs brute-force)")
    }

    return 0
}

/// Suggest using the trie, with case-insensitive matching.
fn suggest_with_trie(trie: Trie, words: List[str], qword: str, k: int) -> List[(int, str)] {
    var candidates = List[(int, str)]()

    // Query the trie with the original word
    let (trie_results, _) = search(trie, qword, k)
    for (d, idx) in trie_results {
        (mut candidates).push((d, words[idx]))
    }

    // Sort by distance, then alphabetically
    sort_candidates(mut candidates)

    return candidates
}

/// Sort a list of ints in place.
fn sort_ints(mut xs: List[int]) {
    let n = xs.len
    for i in 1..n {
        let vi = xs[i]
        var j = i
        while j > 0 && xs[j - 1] > vi {
            xs[j] = xs[j - 1]
            j = j - 1
        }
        xs[j] = vi
    }
}

/// Sort a list of strings in place using insertion sort.
fn sort_strs_list(mut xs: List[str]) {
    let n = xs.len
    for i in 1..n {
        let vi = xs[i]
        var j = i
        while j > 0 && xs[j - 1] > vi {
            xs[j] = xs[j - 1]
            j = j - 1
        }
        xs[j] = vi
    }
}

/// Check if two lists of strings are equal (same elements, same order).
fn lists_equal(a: List[str], b: List[str]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// Extract just the words from a list of (distance, word) pairs.
fn extract_words(pairs: List[(int, str)]) -> List[str] {
    var result = List[str]()
    for (d, w) in pairs {
        (mut result).push(w)
    }
    return result
}

/// Apply a random edit to a word: insertion, deletion, substitution, or transposition.
fn apply_random_edit(word: str, mut r: rand.Rng) -> str {
    let edit_type = rand.below(mut r, 4)
    let n = word.len

    if n == 0 {
        return "a"
    }

    if edit_type == 0 {
        let pos = rand.below(mut r, n)
        let new_char = random_letter(mut r)
        return word[0..pos] + new_char + word[pos + 1..]
    } else if edit_type == 1 {
        let pos = rand.below(mut r, n)
        return word[0..pos] + word[pos + 1..]
    } else if edit_type == 2 {
        let pos = rand.below(mut r, n + 1)
        let new_char = random_letter(mut r)
        if pos >= n {
            return word + new_char
        }
        return word[0..pos] + new_char + word[pos..]
    } else {
        if n < 2 {
            return word
        }
        let pos = rand.below(mut r, n - 1)
        let a = word[pos..pos + 1]
        let b = word[pos + 1..pos + 2]
        return word[0..pos] + b + a + word[pos + 2..]
    }
}

/// Return a random lowercase letter as a string.
fn random_letter(mut r: rand.Rng) -> str {
    let idx = rand.below(mut r, 26)
    let alphabet = "abcdefghijklmnopqrstuvwxyz"
    return alphabet[idx..idx + 1]
}

/// Read all lines from stdin.
fn read_stdin() -> List[str] {
    var lines = List[str]()
    while true {
        let line = read_line() else |_| {
            break
        }
        (mut lines).push(line)
    }
    return lines
}

/// Find unknown words in a line, returning (column, word) pairs.
fn find_unknowns(line: str, dict: Dict, ignore: List[str]) -> List[(int, str)] {
    var result = List[(int, str)]()
    let tokens = tokenize(line)
    for (col, word) in tokens {
        if !is_known_with_ignore(word, dict, ignore) {
            (mut result).push((col, word))
        }
    }
    return result
}
