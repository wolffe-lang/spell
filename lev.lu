/// Edit distance over Unicode code points: Levenshtein and Damerau-Levenshtein.
///
/// `distance(a, b)` returns the full Levenshtein distance.
/// `distance_capped(a, b, k)` returns the distance if <= k, else k+1.
/// `damerau_distance_capped(a, b, k)` is the Damerau variant (transpositions count as 1).

/// Compute the full Levenshtein distance between two strings over code points.
pub fn distance(a: str, b: str) -> int {
    let chars_a = a.chars()
    let chars_b = b.chars()
    let n = chars_a.len
    let m = chars_b.len

    // Handle the empty-string cases
    if n == 0 {
        return m
    }
    if m == 0 {
        return n
    }

    // Two-row DP: prev and curr, each of length m+1
    var prev = List[int]()
    var curr = List[int]()
    for i in 0..=m {
        (mut prev).push(i)
        (mut curr).push(0)
    }

    for i in 1..=n {
        curr[0] = i
        let ca = chars_a[i - 1]
        for j in 1..=m {
            let cb = chars_b[j - 1]
            if ca == cb {
                curr[j] = prev[j - 1]
            } else {
                // min of insert, delete, substitute
                let ins = curr[j - 1] + 1
                let del = prev[j] + 1
                let sub = prev[j - 1] + 1
                curr[j] = min3(ins, del, sub)
            }
        }
        // Swap rows
        var tmp = prev
        prev = curr
        curr = tmp
    }

    return prev[m]
}

/// Compute the Levenshtein distance, but stop as soon as it exceeds k.
/// Returns k+1 when the distance is > k.
pub fn distance_capped(a: str, b: str, k: int) -> int {
    let chars_a = a.chars()
    let chars_b = b.chars()
    let n = chars_a.len
    let m = chars_b.len

    // Quick length check: if the length difference exceeds k, early exit
    let diff = n - m
    if diff < 0 {
        // m > n
        if m - n > k {
            return k + 1
        }
    } else if diff > k {
        return k + 1
    }

    if n == 0 {
        return m
    }
    if m == 0 {
        return n
    }

    var prev = List[int]()
    var curr = List[int]()
    for i in 0..=m {
        (mut prev).push(i)
        (mut curr).push(0)
    }

    for i in 1..=n {
        curr[0] = i
        let ca = chars_a[i - 1]
        var row_min = k + 1
        for j in 1..=m {
            let cb = chars_b[j - 1]
            if ca == cb {
                curr[j] = prev[j - 1]
            } else {
                let ins = curr[j - 1] + 1
                let del = prev[j] + 1
                let sub = prev[j - 1] + 1
                curr[j] = min3(ins, del, sub)
            }
            if curr[j] < row_min {
                row_min = curr[j]
            }
        }
        // If every cell in this row exceeds k, we can stop
        if row_min > k {
            return k + 1
        }
        var tmp = prev
        prev = curr
        curr = tmp
    }

    return prev[m]
}

/// Return the minimum of three integers.
fn min3(a: int, b: int, c: int) -> int {
    if a <= b {
        if a <= c {
            return a
        } else {
            return c
        }
    } else if b <= c {
        return b
    } else {
        return c
    }
}

/// Compute the Damerau-Levenshtein distance, capped at k.
/// Returns k+1 when the distance is > k.
pub fn damerau_distance_capped(a: str, b: str, k: int) -> int {
    let chars_a = a.chars()
    let chars_b = b.chars()
    let n = chars_a.len
    let m = chars_b.len

    // Quick length check
    let diff = n - m
    if diff < 0 {
        if m - n > k {
            return k + 1
        }
    } else if diff > k {
        return k + 1
    }

    if n == 0 {
        return m
    }
    if m == 0 {
        return n
    }

    // Full matrix DP for Damerau-Levenshtein
    var dp = List[List[int]]()
    var i = 0
    while i <= n {
        var row = List[int]()
        var j = 0
        while j <= m {
            if i == 0 {
                (mut row).push(j)
            } else if j == 0 {
                (mut row).push(i)
            } else {
                (mut row).push(0)
            }
            j = j + 1
        }
        (mut dp).push(row)
        i = i + 1
    }

    i = 1
    while i <= n {
        var j = 1
        while j <= m {
            if chars_a[i - 1] == chars_b[j - 1] {
                dp[i][j] = dp[i - 1][j - 1]
            } else {
                dp[i][j] = min3(dp[i][j - 1] + 1, dp[i - 1][j] + 1, dp[i - 1][j - 1] + 1)
            }
            // Transposition
            if i > 1 &&
                j > 1 &&
                chars_a[i - 1] == chars_b[j - 2] &&
                chars_a[i - 2] == chars_b[j - 1] {
                let trans = dp[i - 2][j - 2]
                if trans < dp[i][j] {
                    dp[i][j] = trans
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    let result = dp[n][m]
    if result > k {
        return k + 1
    }
    return result
}
